# PantryRescue Configuration Secrets Template
# -------------------------------------------------------------
# 1. Copy this file to '.streamlit/secrets.toml'
# 2. Replace the placeholder values with your actual API credentials.
#
# Note: '.streamlit/secrets.toml' is git-ignored and contains your sensitive keys.

# Google Gemini API Key (from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY = "AIzaSyYourGeminiApiKeyHere"

# Twilio Credentials (from Twilio Console: https://console.twilio.com/)
TWILIO_ACCOUNT_SID = "ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN = "your_twilio_auth_token_here"

# Twilio WhatsApp Sender Number (e.g. Twilio WhatsApp Sandbox number)
# Format: "whatsapp:+14155238886"
TWILIO_WHATSAPP_FROM = "whatsapp:+14155238886"

# Twilio Content SID (Approved Content Template SID for WhatsApp)
# e.g. "HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_CONTENT_SID = "HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
